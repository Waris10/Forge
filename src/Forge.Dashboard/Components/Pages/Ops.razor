@page "/ops"
@rendermode InteractiveServer
@using Forge.Dashboard.Live
@inject LiveStateBroadcaster Broadcaster
@implements IDisposable

<h1>Ops</h1>

<table>
    <tr><td>Ready depth</td><td>@_counters.ReadyDepth</td></tr>
    <tr><td>Scheduled depth</td><td>@_counters.ScheduledDepth</td></tr>
    <tr><td>DLQ depth</td><td>@_counters.DlqDepth</td></tr>
    <tr><td>Workers alive</td><td>@_counters.WorkersAlive</td></tr>
    <tr><td>Captured</td><td>@_counters.CapturedAt.ToString("HH:mm:ss")</td></tr>
</table>

@code {
    private LiveCounters _counters = new(0, 0, 0, 0, DateTime.UtcNow);

    protected override void OnInitialized()
    {
        // First paint: latest snapshot, no flash of zeros.
        _counters = Broadcaster.Latest;
        Broadcaster.OnCountersChanged += HandleUpdate;
    }

    private async void HandleUpdate(LiveCounters c)
    {
        _counters = c;
        // Marshal to UI thread — required because the event fires on
        // the broadcaster's BackgroundService thread, not the circuit's.
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose() => Broadcaster.OnCountersChanged -= HandleUpdate;
}